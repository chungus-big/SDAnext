<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:NextAuth.Core.ViewModel.Other;assembly=NextAuth.Core"
             x:Class="NextAuth.Desktop.Views.Dialogs.LoginAgainOnImportView"
             x:DataType="vm:LoginAgainOnImportVM">
    <Border Padding="24" Width="400">
        <StackPanel Spacing="12">
            <StackPanel Orientation="Horizontal" Spacing="6">
                <TextBlock Text="{Binding Loc[LoginAgainDialog.LoginFor]}" FontWeight="SemiBold" FontSize="16" />
                <TextBlock Text="{Binding UserName}" FontWeight="SemiBold" FontSize="16" />
            </StackPanel>

            <TextBox Text="{Binding Password}" PlaceholderText="{Binding Loc[LoginAgainDialog.PasswordBox]}" PasswordChar="●" />

            <CheckBox Content="{Binding Loc[LoginAgainDialog.SaveEncryptedPassword]}" IsChecked="{Binding SavePassword}" />

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
                <Button x:Name="CancelButton" Content="{Binding Loc[Common.Cancel]}" IsCancel="True" />
                <Button x:Name="OkButton" Content="{Binding Loc[LoginAgainDialog.LoginButton]}" IsDefault="True" />
            </StackPanel>
        </StackPanel>
    </Border>
</UserControl>
